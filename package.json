{
  "name": "auto-skeleton-loader-generator",
  "version": "0.1.0",
  "description": "Auto-generate skeleton loader components from existing JSX/TSX component structure",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "auto-skeleton": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "generate": "node dist/cli.js generate",
    "demo": "vite",
    "demo:build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muzammil328/auto-skeleton-loader-generator.git"
  },
  "bugs": {
    "url": "https://github.com/muzammil328/auto-skeleton-loader-generator/issues"
  },
  "homepage": "https://github.com/muzammil328/auto-skeleton-loader-generator#readme",
  "keywords": [
    "skeleton",
    "loader",
    "react",
    "jsx",
    "tsx",
    "ast",
    "codegen"
  ],
  "author": "Muzammal Safdar",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.26.3",
    "@babel/traverse": "^7.26.5",
    "@babel/types": "^7.26.3",
    "commander": "^12.1.0"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.7",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
